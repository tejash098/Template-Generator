# Supabase project (see decisions.md). The publishable key is safe to ship in
# the client; Row Level Security is the real boundary. Copy to .env.
#
# vite.config.ts also accepts the names the Vercel <-> Supabase integration
# sets, so on Vercel nothing needs renaming:
#   URL: VITE_SUPABASE_URL | SUPABASE_URL | NEXT_PUBLIC_SUPABASE_URL
#   key: VITE_SUPABASE_PUBLISHABLE_KEY | SUPABASE_PUBLISHABLE_KEY
#        | NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY | SUPABASE_ANON_KEY | NEXT_PUBLIC_SUPABASE_ANON_KEY
# Never put the service-role / secret key here or in any VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
